# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (optional in local dev; falls back to local SQLite when unset).
DATABASE_URL=""


# LoftLife edge identity (Cloudflare Worker -> Neon -> game server)
# DATABASE_URL is the Neon pooled connection string used by the Worker.
# LOFTLIFE_SESSION_SECRET must be identical on the Worker and the Node server;
# it signs the session tokens the game server verifies (>= 32 characters).
LOFTLIFE_SESSION_SECRET=""
GAME_ORIGIN="http://127.0.0.1:8787"

# Imported Kenney 3D assets (CC0). Local development serves them from public/.
# Production: upload with `npm run assets:upload`, then build with this set to the
# public R2/CDN root ending in /catalog/v1 (absolute URL, no trailing slash).
# VITE_ASSET_BASE_URL="https://assets.example.com/catalog/v1"
# Unset/empty: dev serves public/, and a production build bundles the ~112 MB
# of models and previews into dist/ (with a warning).
VITE_ASSET_BASE_URL=""

# R2 upload credentials (never commit values):
#   CATALOG_R2_BUCKET=loftlife-assets
#   CLOUDFLARE_API_TOKEN=...
#   CLOUDFLARE_ACCOUNT_ID=...
