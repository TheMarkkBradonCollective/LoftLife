{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node server/index.mjs",
    "dev:full": "node scripts/dev.mjs",
    "test": "node --test server/test/*.test.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:edge": "node scripts/verify-edge-auth.mjs",
    "check:city": "node scripts/check-city-venues.mjs",
    "check:hotel": "node scripts/check-hotel-airport.mjs",
    "check:transit": "node scripts/check-transit-network.mjs",
    "check:worlds": "node scripts/check-world-layout.mjs",
    "assets:previews": "node scripts/render-catalog-previews.mjs",
    "assets:check": "node scripts/render-catalog-previews.mjs --validate-only && node scripts/render-kenney-previews.mjs --validate-only",
    "assets:import": "node scripts/import-kenney-library.mjs",
    "assets:kenney": "node scripts/render-kenney-previews.mjs",
    "assets:gallery": "node scripts/build-catalog-gallery.mjs",
    "check:character": "node scripts/check-character.mjs",
    "check:finance": "node scripts/check-finance.mjs",
    "db:seed": "node scripts/seed-catalog-neon.mjs",
    "assets:upload": "node scripts/upload-catalog-r2.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
